<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CCChartMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CCChartMVC.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #0f172a;
            color: #e2e8f0;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-custom {
            background: linear-gradient(135deg, #1e293b, #0f172a);
            border-bottom: 1px solid #334155;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #38bdf8 !important;
        }
        .nav-link {
            color: #94a3b8 !important;
            font-weight: 500;
            transition: all 0.2s ease;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
        }
        .nav-link:hover {
            color: #ffffff !important;
            background-color: rgba(56, 189, 248, 0.1);
        }
        .chart-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            transition: border-color 0.2s ease;
        }
        .chart-card:hover {
            border-color: #38bdf8;
        }
        footer {
            margin-top: auto;
            background: #0f172a;
            border-top: 1px solid #1e293b;
            color: #64748b;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="ChartJs" asp-action="Index">
                    <i class="bi bi-bar-chart-fill fs-4 text-info"></i>
                    <span>CCChartMVC</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ChartJs" asp-action="Index">
                                <i class="bi bi-graph-up me-1 text-primary"></i> 1. Chart.js
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ApexCharts" asp-action="Index">
                                <i class="bi bi-pie-chart me-1 text-warning"></i> 2. ApexCharts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CanvasJs" asp-action="Index">
                                <i class="bi bi-bar-chart-steps me-1 text-success"></i> 3. CanvasJS
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Highcharts" asp-action="Index">
                                <i class="bi bi-box me-1 text-danger"></i> 4. Highcharts 3D
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 text-center">
        <div class="container">
            <small>&copy; 2026 Cyber Cafe System - CCChartMVC</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
