@{
    ViewData["Title"] = "Highcharts - 3D Charts";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger">Chart Library #4</span>
            <span class="text-secondary small">Highcharts 3D Suite</span>
        </div>
        <h2 class="text-white fw-bold mt-1 mb-0">Highcharts - 3D Visual Reports</h2>
    </div>
    <div>
        <a href="https://www.highcharts.com/demo" target="_blank" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-box-arrow-up-right me-1"></i> highcharts.com
        </a>
    </div>
</div>

<!-- Chart 1: 3D Pie -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="chart-card">
            <div id="highcharts3dContainer" style="height: 380px; width: 100%;"></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card h-100">
            <h5 class="text-white mb-2"><i class="bi bi-sliders me-2 text-danger"></i>3D Angle Controls</h5>
            <p class="text-secondary small mb-3">
                Adjust the perspective angles in real-time.
            </p>

            <div class="mb-3">
                <label for="alphaSlider" class="form-label text-light d-flex justify-content-between small">
                    <span>Alpha Angle (Tilt X):</span>
                    <span id="alphaValue" class="text-info fw-bold">15&deg;</span>
                </label>
                <input type="range" class="form-range" id="alphaSlider" min="0" max="45" value="15">
            </div>

            <div class="mb-3">
                <label for="betaSlider" class="form-label text-light d-flex justify-content-between small">
                    <span>Beta Angle (Rotation Y):</span>
                    <span id="betaValue" class="text-info fw-bold">0&deg;</span>
                </label>
                <input type="range" class="form-range" id="betaSlider" min="-45" max="45" value="0">
            </div>

            <div class="p-2 rounded" style="background: rgba(15, 23, 42, 0.6);">
                <div class="text-danger small fw-bold mb-1"><i class="bi bi-info-circle me-1"></i> Interactive:</div>
                <div class="text-secondary small">Click any slice to detach from the 3D ring.</div>
            </div>
        </div>
    </div>
</div>

<!-- Chart 2: 3D Column Chart -->
<div class="chart-card mb-4">
    <div class="mb-3">
        <h5 class="text-white mb-0">2. Revenue Generated by Unit ($)</h5>
        <small class="text-secondary">3D Column visual showing total income per computer / console station</small>
    </div>
    <div id="highcharts3dColumnContainer" style="height: 380px; width: 100%;"></div>
</div>

@section Scripts {
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/highcharts-3d.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script>
        var pieData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PieData));
        var columnCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ColumnCategories));
        var columnRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ColumnRevenues));

        // Chart 1: 3D Pie Chart
        var pieChart = Highcharts.chart('highcharts3dContainer', {
            chart: {
                type: 'pie',
                backgroundColor: 'transparent',
                options3d: { enabled: true, alpha: 15, beta: 0 }
            },
            title: {
                text: '1. Revenue Share by Unit (%)',
                style: { color: '#e2e8f0', fontSize: '16px', fontWeight: 'bold' }
            },
            tooltip: {
                pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b> ({point.y}%)'
            },
            plotOptions: {
                pie: {
                    allowPointSelect: true,
                    cursor: 'pointer',
                    depth: 35,
                    dataLabels: {
                        enabled: true,
                        format: '{point.name}: {point.percentage:.1f}%',
                        style: { color: '#e2e8f0', textOutline: 'none', fontSize: '12px' }
                    }
                }
            },
            series: [{
                type: 'pie',
                name: 'Share',
                data: pieData
            }]
        });

        // 3D Angle Sliders for Pie
        var alphaSlider = document.getElementById('alphaSlider');
        var betaSlider = document.getElementById('betaSlider');
        var alphaVal = document.getElementById('alphaValue');
        var betaVal = document.getElementById('betaValue');

        function update3dAngles() {
            pieChart.options.chart.options3d.alpha = parseFloat(alphaSlider.value);
            pieChart.options.chart.options3d.beta = parseFloat(betaSlider.value);
            alphaVal.innerHTML = alphaSlider.value + '&deg;';
            betaVal.innerHTML = betaSlider.value + '&deg;';
            pieChart.redraw(false);
        }

        alphaSlider.addEventListener('input', update3dAngles);
        betaSlider.addEventListener('input', update3dAngles);

        // Chart 2: 3D Column Chart
        Highcharts.chart('highcharts3dColumnContainer', {
            chart: {
                type: 'column',
                backgroundColor: 'transparent',
                options3d: { enabled: true, alpha: 10, beta: 15, depth: 50, viewDistance: 25 }
            },
            title: {
                text: 'Total Revenue by Unit ($)',
                style: { color: '#e2e8f0', fontSize: '16px', fontWeight: 'bold' }
            },
            xAxis: {
                categories: columnCategories,
                labels: { style: { color: '#94a3b8' } }
            },
            yAxis: {
                title: { text: 'Revenue ($)', style: { color: '#94a3b8' } },
                labels: {
                    formatter: function() { return '$' + this.value; },
                    style: { color: '#94a3b8' }
                },
                gridLineColor: 'rgba(255, 255, 255, 0.05)'
            },
            tooltip: {
                pointFormat: 'Total Revenue: <b>${point.y:,.2f}</b>'
            },
            plotOptions: {
                column: {
                    depth: 25,
                    colorByPoint: true
                }
            },
            colors: ['#38bdf8', '#818cf8', '#c084fc', '#f472b6', '#fb7185', '#fbbf24', '#34d399'],
            series: [{
                name: 'Revenue',
                data: columnRevenues,
                showInLegend: false
            }]
        });
    </script>
}
