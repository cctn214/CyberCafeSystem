@{
    ViewData["Title"] = "CanvasJS - Customer Spending Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success">Chart Library #3</span>
            <span class="text-secondary small">CanvasJS HTML5 Charting</span>
        </div>
        <h2 class="text-white fw-bold mt-1 mb-0">CanvasJS - Customer Spending vs Balance</h2>
    </div>
    <div>
        <a href="https://canvasjs.com/" target="_blank" class="btn btn-outline-success btn-sm">
            <i class="bi bi-box-arrow-up-right me-1"></i> canvasjs.com
        </a>
    </div>
</div>

<div class="chart-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="text-white mb-0">Customer Spending vs Account Balance</h5>
            <small class="text-secondary">Comparing total rental spend against remaining account balance</small>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <label class="text-secondary small me-1">Theme:</label>
            <select id="themeSelector" class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 140px;">
                <option value="dark1" selected>Dark 1</option>
                <option value="dark2">Dark 2</option>
                <option value="light1">Light 1</option>
                <option value="light2">Light 2</option>
            </select>
        </div>
    </div>
    <div id="canvasJsContainer" style="height: 400px; width: 100%;"></div>
</div>

@section Scripts {
    <script src="https://cdn.canvasjs.com/canvasjs.min.js"></script>
    <script>
        // Simple C# to JS data pass
        var spendingData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SpendingPoints));
        var balanceData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.BalancePoints));

        function renderCanvasJsChart(themeName) {
            var chart = new CanvasJS.Chart("canvasJsContainer", {
                animationEnabled: true,
                theme: themeName || "dark1",
                backgroundColor: themeName.startsWith("dark") ? "#1e293b" : "#ffffff",
                title: {
                    text: "User Spending vs Account Balance ($)",
                    fontColor: themeName.startsWith("dark") ? "#e2e8f0" : "#333333",
                    fontSize: 18
                },
                axisX: {
                    labelFontColor: themeName.startsWith("dark") ? "#94a3b8" : "#333333",
                    interval: 1
                },
                axisY: {
                    title: "Amount in USD ($)",
                    labelFontColor: themeName.startsWith("dark") ? "#94a3b8" : "#333333",
                    titleFontColor: themeName.startsWith("dark") ? "#38bdf8" : "#0d6efd",
                    prefix: "$"
                },
                toolTip: {
                    shared: true
                },
                legend: {
                    cursor: "pointer",
                    fontColor: themeName.startsWith("dark") ? "#e2e8f0" : "#333333"
                },
                data: [
                    {
                        type: "column",
                        name: "Total Spent ($)",
                        showInLegend: true,
                        color: "#38bdf8",
                        yValueFormatString: "$#,##0.00",
                        dataPoints: spendingData
                    },
                    {
                        type: "column",
                        name: "Current Balance ($)",
                        showInLegend: true,
                        color: "#4ade80",
                        yValueFormatString: "$#,##0.00",
                        dataPoints: balanceData
                    }
                ]
            });
            chart.render();
        }

        // Initial render
        renderCanvasJsChart("dark1");

        // Theme selector change listener
        document.getElementById("themeSelector").addEventListener("change", function () {
            renderCanvasJsChart(this.value);
        });
    </script>
}
