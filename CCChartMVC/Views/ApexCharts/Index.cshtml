@{
    ViewData["Title"] = "ApexCharts - Simple Pie";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning text-dark">Chart Library #2</span>
            <span class="text-secondary small">ApexCharts Simple Pie Demo</span>
        </div>
        <h2 class="text-white fw-bold mt-1 mb-0">ApexCharts - Rental Share Distribution</h2>
    </div>
    <div>
        <a href="https://apexcharts.com/javascript-chart-demos/pie-charts/simple-pie/" target="_blank" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-box-arrow-up-right me-1"></i> Official Demo
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="chart-card d-flex flex-column align-items-center justify-content-center" style="min-height: 450px;">
            <div id="apexSimplePieChart"></div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="chart-card h-100">
            <h5 class="text-white mb-3">Rental Popularity Breakdown</h5>
            <p class="text-secondary small">
                Interactive simple pie chart showing the proportion of rental activity across each computer category in the cyber cafe.
            </p>

            <div class="p-3 rounded mb-3" style="background: rgba(15, 23, 42, 0.6);">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary">Total Sessions Logged:</span>
                    <span class="badge bg-warning text-dark fs-6">@ViewBag.TotalSessions</span>
                </div>
            </div>

            <div class="list-group list-group-flush bg-transparent">
                @{
                    var labels = (List<string>)ViewBag.Labels;
                    var series = (List<int>)ViewBag.Series;
                    for (int i = 0; i < labels.Count; i++)
                    {
                        var pct = ViewBag.TotalSessions > 0 ? (series[i] * 100.0 / (int)ViewBag.TotalSessions) : 0;
                        <div class="list-group-item bg-transparent text-light d-flex justify-content-between align-items-center px-0 border-secondary">
                            <div>
                                <i class="bi bi-circle-fill text-warning me-2 small"></i>
                                <span>@labels[i]</span>
                            </div>
                            <span class="fw-bold">@series[i] (@pct.ToString("0.0")%)</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        // Simple C# to JS data pass
        var seriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Series));
        var labelsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Labels));

        var options = {
            series: seriesData,
            chart: {
                width: 420,
                type: 'pie',
                foreColor: '#94a3b8'
            },
            labels: labelsData,
            colors: ['#008FFB', '#00E396', '#FEB019', '#FF4560', '#775DD0'],
            legend: {
                position: 'bottom',
                labels: {
                    colors: '#e2e8f0'
                }
            },
            dataLabels: {
                enabled: true,
                style: {
                    fontSize: '14px',
                    fontWeight: 'bold'
                }
            },
            responsive: [{
                breakpoint: 480,
                options: {
                    chart: {
                        width: 300
                    },
                    legend: {
                        position: 'bottom'
                    }
                }
            }]
        };

        var chart = new ApexCharts(document.querySelector("#apexSimplePieChart"), options);
        chart.render();
    </script>
}
